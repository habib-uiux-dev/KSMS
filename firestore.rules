rules_version = '2';

// Paste into Firebase console > Firestore Database > Security, with the
// `default` database selected, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Rules run server-side with full read access, so this can look at a
    // document the client itself is forbidden to read.
    function isAdmin() {
      return signedIn()
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminCode() {
      return get(/databases/$(database)/documents/config/admin).data.code;
    }

    // The shop day, as yyyyMMdd, in Bangladesh time.
    //
    // request.time is UTC and Bangladesh is a fixed UTC+6 with no DST, so a
    // six-hour shift converts it exactly. Without this, everything ordered
    // before 6am local would be filed under the previous day.
    function bdNow() {
      return request.time + duration.value(6, 'h');
    }

    function todayKey() {
      return bdNow().year() * 10000 + bdNow().month() * 100 + bdNow().day();
    }

    // Fail OPEN when settings/ordering is missing.
    //
    // Deliberate: the failure mode of fail-closed is an office where nobody can
    // order and nobody can see why. Only an admin can write this document, so a
    // user cannot delete it to force the shop open.
    function orderingOpen() {
      return !exists(/databases/$(database)/documents/settings/ordering)
             || get(/databases/$(database)/documents/settings/ordering).data.is_open == true;
    }

    // ------------------------------------------------------------ config
    //
    // Holds the admin secret. Closed to every client in both directions - the
    // only thing that ever reads it is adminCode() above. Create it by hand in
    // the console:  config/admin  ->  { code: "sajjad-vai" }
    match /config/{document} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------- settings
    //
    // Shop-wide switches every client must be able to read. Kept apart from
    // `config` so the admin secret stays unreadable while this stays public.
    //
    //   settings/ordering  ->  { is_open: true }
    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------ admins
    //
    // Unlocking is a self-write whose `code` field must match config/admin.
    // Because the comparison happens here, the secret never ships in the app
    // and cannot be read out of Firestore by a client.
    match /admins/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.code == adminCode();
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // ------------------------------------------------------------- users
    //
    // Any signed-in user can read user profiles so attendee lists and names
    // render across the app. A person owns and writes their own document;
    // admins can read and write all user documents.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    // ---------------------------------------------------------- products
    match /products/{productId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------ orders
    //
    // One order per person per shop day, enforced by the document id:
    //   orders/{uid}_{yyyyMMdd}
    //
    // Pinning the id to the caller's uid and to the server's own date is what
    // makes "one a day" real rather than a UI convention - a second order is a
    // write to the same document, and a back-dated id is rejected outright.
    match /orders/{orderId} {

      allow create: if signedIn()
                    && orderingOpen()
                    && request.resource.data.user_id == request.auth.uid
                    && request.resource.data.order_date == todayKey()
                    && orderId == request.auth.uid + '_' + string(todayKey())
                    // Nobody marks their own order paid.
                    && request.resource.data.payment_status == 'pending';

      // Readable by anyone signed in, because the leaderboard adds up the whole
      // office and Firestore has no way to serve a total without serving the
      // rows behind it. The trade-off is real and worth saying out loud: any
      // colleague can now see any other colleague's individual orders. Closing
      // that would mean a Cloud Function writing pre-computed totals to a
      // separate collection, which this project does not have.
      allow read: if signedIn();

      // The owner may change the basket, and only the basket - while the shop
      // is open and before the cash has been collected. Editing after payment
      // would put the collected total and the order out of step.
      //
      // A cancelled order is excluded here so the ONLY way out of `cancelled`
      // is the revive rule below, which insists the status flips too. Without
      // that check someone could edit the lines of a struck-out order and be
      // looking at a basket that no longer means anything.
      allow update: if signedIn()
                    && resource.data.user_id == request.auth.uid
                    && orderingOpen()
                    && resource.data.payment_status == 'pending'
                    && resource.data.status != 'cancelled'
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['items', 'item_count', 'total', 'updated_at']);

      // Ordering again after the shop cancelled today's order.
      //
      // The document id is uid_yyyyMMdd, so the cancelled order still occupies
      // the address a new one would need - reviving it in place is what keeps
      // one-order-per-day true with no second document to reconcile.
      //
      // Safe against abuse because only an admin can set 'cancelled' in the
      // first place: a user cannot cancel-and-reorder their way to two orders.
      allow update: if signedIn()
                    && resource.data.user_id == request.auth.uid
                    && orderingOpen()
                    && resource.data.status == 'cancelled'
                    && request.resource.data.status == 'placed'
                    && request.resource.data.payment_status == 'pending'
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['items', 'item_count', 'total', 'updated_at',
                                   'status', 'cancelled_at', 'cancelled_by',
                                   'cancel_reason']);

      // An admin may move money.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['payment_status', 'collected_at']);

      // ...and correct the basket, because the person behind the counter is the
      // one who finds out that the packet is gone or that somebody asked for a
      // second one in person.
      //
      // Note what stays untouchable even here: user_id, order_date and
      // created_at. An admin can fix what was ordered; an admin cannot move an
      // order onto somebody else's name or into another day.
      //
      // Unlike the owner's rule this does not require orderingOpen() or a
      // pending payment - corrections happen after the shop shuts, which is
      // precisely when they are needed.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['items', 'item_count', 'total', 'updated_at']);

      // An admin cancels rather than deletes.
      //
      // Deleting is refused outright below, and that is the point: a deleted
      // order cannot be shown to the person who placed it, so "your order was
      // cancelled" would have nothing to render. The document has to survive
      // for the message to exist.
      //
      // payment_status must still be 'pending'. Cancelling an order whose cash
      // is already in the tin would leave the takings and the orders
      // disagreeing - the admin has to undo the collection first, which is a
      // real step because the money has to go back.
      allow update: if isAdmin()
                    && resource.data.status != 'cancelled'
                    && resource.data.payment_status == 'pending'
                    && request.resource.data.status == 'cancelled'
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['status', 'cancelled_at', 'cancelled_by',
                                   'cancel_reason', 'updated_at']);

      // Nobody deletes an order - not the owner, not an admin. Cancelling is
      // the only removal, and it keeps the trail.
      allow delete: if false;
    }

    // ------------------------------------------------------------ events
    //
    // Meal and Gift events (MealEvent, GiftEvent).
    // Document ID: eventId
    match /events/{eventId} {
      allow read, write, delete: if request.auth != null;
    }

    // ---------------------------------------------------------- expenses
    //
    // Expense items and records.
    match /expenses/{expenseId} {
      allow read, write, delete: if request.auth != null;
    }

    // ------------------------------------------------------------- chats
    //
    // 1-on-1 real-time chat conversations between two users.
    // Document ID: deterministic chatId between two users (e.g. uid1_uid2)
    //
    // Each conversation document tracks participant UIDs, names, photos,
    // last message snippet/timestamp, and unread counts per user.
    match /chats/{chatId} {

      function isChatParticipant() {
        return signedIn() && (
          chatId.matches('^' + request.auth.uid + '_.*')
          || chatId.matches('.*_' + request.auth.uid + '$')
          || (resource != null && request.auth.uid in resource.data.participants)
          || (exists(/databases/$(database)/documents/chats/$(chatId))
              && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants)
        );
      }

      // Only signed-in participants can read or update the conversation document.
      allow read, update: if isChatParticipant();

      // A user can start a conversation if they are listed in participants.
      allow create: if signedIn() && (request.auth.uid in request.resource.data.participants);

      // Conversations cannot be deleted directly to preserve chat history.
      allow delete: if false;

      // ---------------------------------------------------------- messages
      //
      // Individual messages in the chat conversation.
      // Ordered chronologically by timestamp.
      match /messages/{messageId} {

        // Any authenticated participant of the chat can read messages.
        allow read: if isChatParticipant();

        // An authenticated user can create a message if they are the sender.
        allow create: if signedIn()
                      && request.auth.uid == request.resource.data.sender_id
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 5000;

        // The receiver can mark a message as read (is_read, read_at).
        // Other fields (text, sender_id, receiver_id, timestamp) cannot be modified.
        allow update: if signedIn()
                      && request.auth.uid == resource.data.receiver_id
                      && request.resource.data.diff(resource.data)
                           .affectedKeys()
                           .hasOnly(['is_read', 'read_at']);

        // Messages cannot be deleted to preserve the audit trail.
        allow delete: if false;
      }

      // ------------------------------------------------------------ calls
      //
      // 1-on-1 WebRTC audio/video call signaling sessions.
      // Subcollections hold ICE candidates for caller and receiver.
      match /calls/{callId} {

        // Allow read: if signedIn() and (caller is callerId or receiverId, or authenticated participant of parent chat)
        allow read: if signedIn() && (
          resource == null
          || request.auth.uid == resource.data.callerId
          || request.auth.uid == resource.data.receiverId
          || (exists(/databases/$(database)/documents/chats/$(chatId))
              && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants)
        );

        // Allow create: if signedIn() and request.auth.uid == request.resource.data.callerId
        allow create: if signedIn()
                      && request.auth.uid == request.resource.data.callerId;

        // Allow update: if signedIn() and (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.receiverId)
        allow update: if signedIn()
                      && (request.auth.uid == resource.data.callerId
                          || request.auth.uid == resource.data.receiverId);

        // Allow delete: if false
        allow delete: if false;

        match /callerCandidates/{candidateId} {
          allow read, create: if signedIn();
        }

        match /receiverCandidates/{candidateId} {
          allow read, create: if signedIn();
        }
      }
    }

    // ----------------------------------------------------------- accounts
    //
    // Accounts module entries (Jorimana and Expense records)
    match /accounts/{accountId} {
      allow read, write, delete: if signedIn();
    }

    // Everything else is closed until a feature needs it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
