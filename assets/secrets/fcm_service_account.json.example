{
  "_README": [
    "Copy this file to  assets/secrets/fcm_service_account.json  with the real",
    "values, then rebuild. The real file is gitignored on purpose.",
    "",
    "Where to get it:",
    "  Firebase Console > Project settings > Service accounts",
    "  > Manage service account permissions (opens Google Cloud IAM)",
    "  > + CREATE SERVICE ACCOUNT",
    "      name:  kms-fcm-sender",
    "      role:  Firebase Cloud Messaging API Admin",
    "             (ONLY this role - see why below)",
    "  > open it > KEYS > ADD KEY > Create new key > JSON > download",
    "",
    "Why a new, narrow service account instead of the default one:",
    "  This key ships inside the APK, so anyone who unzips the app can read it.",
    "  With only the messaging role, the worst someone can do with it is send",
    "  notifications to this app. The default 'firebase-adminsdk' account can",
    "  also read and delete your whole Firestore, which is not a thing to hand",
    "  out with the app.",
    "",
    "If the key ever leaks: delete it in IAM > Keys and add a new one. The app",
    "needs a rebuild after that."
  ],

  "type": "service_account",
  "project_id": "ksms-1ad4b",
  "private_key_id": "PUT_YOURS_HERE",
  "private_key": "-----BEGIN PRIVATE KEY-----\nPUT_YOURS_HERE\n-----END PRIVATE KEY-----\n",
  "client_email": "kms-fcm-sender@ksms-1ad4b.iam.gserviceaccount.com",
  "client_id": "PUT_YOURS_HERE",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "PUT_YOURS_HERE"
}
